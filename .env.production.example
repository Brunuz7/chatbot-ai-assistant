# Produção via Docker — copie para `.env` na raiz do projeto
#
# Subir:  bash scripts/docker-prod-up.sh
# Parar:  bash scripts/docker-prod-down.sh
#
# Domínios (nginx no Docker):
#   prestei.com / www.prestei.com  → frontend (build estático)
#   api.prestei.com                → backend
#   evolution.prestei.com          → api-evolution
#
# SSL: monta /etc/letsencrypt do host (Certbot no servidor)

NODE_ENV=production
POSTGRES_PASSWORD=change-me

# --- Frontend (embutidas no build do nginx) ---
VITE_API_URL=https://api.prestei.com
VITE_APP_URL=https://prestei.com
VITE_META_EMBEDDED_REDIRECT_URI=https://prestei.com/
VITE_META_APP_ID=
VITE_META_EMBEDDED_CONFIG_ID=
VITE_WHATSAPP_EVOLUTION_CHANNEL_ENABLED=1

# --- Backend ---
FRONTEND_ORIGIN=https://prestei.com,https://www.prestei.com
TRUST_PROXY=1
TRUST_PROXY_HOPS=1
PUBLIC_API_URL=https://api.prestei.com
WEBHOOK_URL=https://api.prestei.com/webhook/evolution
EVOLUTION_API_URL=http://api-evolution:8080
EVOLUTION_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_OAUTH_REDIRECT_URI=https://prestei.com/
META_GRAPH_VERSION=v25.0
ENABLE_BACKGROUND_WORKERS=1
WHATSAPP_EVOLUTION_CHANNEL_ENABLED=1

# --- Evolution API ---
SERVER_NAME=evolution
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=https://evolution.prestei.com
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_CLIENT_NAME=evolution
DATABASE_SAVE_DATA_INSTANCE=true
AUTHENTICATION_API_KEY=
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true
LANGUAGE=pt-BR

# --- Cloudinary ---
CLOUDINARY_ACCOUNT_1_CLOUD_NAME=
CLOUDINARY_ACCOUNT_1_API_KEY=
CLOUDINARY_ACCOUNT_1_API_SECRET=
CLOUDINARY_ACCOUNT_2_CLOUD_NAME=
CLOUDINARY_ACCOUNT_2_API_KEY=
CLOUDINARY_ACCOUNT_2_API_SECRET=
