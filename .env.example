# Copie para `.env` na raiz do monorepo (backend, frontend e api-evolution leem o mesmo ficheiro).
# cp .env.example .env

# --- Base de dados (backend / Prisma) ---
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/prestei_chatbot_db

# --- Backend + integrações ---
# URL pública da API (Evolution e Meta chamam os webhooks deste host)
WEBHOOK_URL=http://api.prestei.com/webhook/evolution
EVOLUTION_API_URL=https://evolution.prestei.com
EVOLUTION_API_KEY=
OPENROUTER_API_KEY=

# WhatsApp Cloud API — webhook oficial (cadastro incorporado + mensagens)
# A Meta envia eventos para a URL de callback configurada no painel do app (sem chave extra de signup).
# Callback: {sua-api}/webhook/whatsapp-official
# Painel Meta → Webhooks: URL acima + Verify Token abaixo; inscrever account_update e messages na WABA.
# GET: hub.verify_token deve coincidir com META_WEBHOOK_VERIFY_TOKEN (verificação inicial).
# META_WEBHOOK_VERIFY_TOKEN=
# META_APP_SECRET=   # opcional — só valida X-Hub-Signature-256 (recomendado em produção, não obrigatório para receber)

# Clone de voz Mistral (opcional — só se usar "minha voz" em Configurações)
# MISTRAL_API_KEY=

# Cookie de sessão (refresh). Em HTTP local use COOKIE_SECURE=0 se a API não for HTTPS.
# COOKIE_SECURE=0

# JWT (defina em produção; em dev o backend usa segredos de desenvolvimento)
# ACCESS_TOKEN_SECRET=
# REFRESH_TOKEN_SECRET=
# Sessão do utilizador (cookie refresh + JWT refresh). Padrão: 30 dias.
# SESSION_REFRESH_DAYS=30
# ACCESS_TOKEN_EXPIRES=1h

# --- Frontend (Vite) ---
# Em dev local use o mesmo host do Vite (localhost), não 127.0.0.1 — senão o cookie de sessão não funciona.
VITE_API_URL=http://localhost:3001
VITE_APP_URL=https://app.prestei.com
# URL do frontend (Vite dev = :5173). Não use a porta da API (:3001).
FRONTEND_ORIGIN=http://localhost:5173

# --- Cloudinary (loja integrada — duas contas free com balanceamento) ---
# CLOUD_NAME: painel Cloudinary → Dashboard (cada conta tem o seu).
# prestei.app+cloud@gmail.com
CLOUDINARY_ACCOUNT_1_CLOUD_NAME=
CLOUDINARY_ACCOUNT_1_API_KEY=
CLOUDINARY_ACCOUNT_1_API_SECRET=
# prestei.app+cloud01@gmail.com
CLOUDINARY_ACCOUNT_2_CLOUD_NAME=
CLOUDINARY_ACCOUNT_2_API_KEY=
CLOUDINARY_ACCOUNT_2_API_SECRET=

# --- Setup local de bases PostgreSQL (`npm run setup:db`) ---
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=prestei_chatbot_db
DB_NAME2=evolution_db

# --- Evolution API (api-evolution) ---
# OBRIGATÓRIO: a mesma chave em EVOLUTION_API_KEY (backend) e AUTHENTICATION_API_KEY (Evolution).
# Se forem diferentes, o QR Code e a ligação WhatsApp falham com erro de autorização.
SERVER_URL=https://evolution.prestei.com
DATABASE_CONNECTION_URI=postgresql://postgres:password@127.0.0.1:5432/evolution_db
AUTHENTICATION_API_KEY=
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true
LANGUAGE=pt-BR

# Persistência no Postgres da Evolution (por defeito no código fica desligado)
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_HISTORIC=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_DELETE_MESSAGE=true
