{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "npm run db:generate && tsc -p tsconfig.build.json",
    "start:prod": "node dist/index.js",
    "prisma": "node scripts/prisma-cli.mjs",
    "db:generate": "node scripts/prisma-cli.mjs generate",
    "db:migrate": "node scripts/prisma-cli.mjs migrate dev",
    "db:migrate:deploy": "node scripts/prisma-cli.mjs migrate deploy",
    "db:studio": "node scripts/prisma-cli.mjs studio",
    "db:status": "node scripts/prisma-cli.mjs migrate status",
    "postinstall": "node scripts/install-prisma-shim.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@openrouter/agent": "^0.4.0",
    "@openrouter/sdk": "^0.1.27",
    "@prisma/client": "^5.22.0",
    "axios": "^1.15.2",
    "bcrypt": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^6.7.0",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.20.0",
    "prisma": "^5.22.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "tar": "^7.5.11"
  }
}
