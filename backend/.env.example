# Exemplo de variáveis de ambiente para o backend
# NÃO comite sua chave real. Defina estas variáveis localmente ou em seu provedor de deploy.

# Chave da API da OpenRouter (obrigatório)
OPENROUTER_API_KEY=

# Modelo a ser usado (opcional)
OPENROUTER_MODEL=gpt-4o-mini

# URL da API (opcional)
OPENROUTER_URL=https://api.openrouter.ai/v1/chat/completions
