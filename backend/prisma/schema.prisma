generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id              String         @id @default(uuid())
  name            String
  slug            String         @unique
  email           String         @unique
  password_hash   String
  role            String         @default("user")
  failed_attempts Int            @default(0)
  locked_until    DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  ai_config       ai_config?
  connections     connection[]
  instruction     user_instruction?
  refresh_tokens  refresh_token[]
}

model refresh_token {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  created_at DateTime @default(now())
  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "refresh_token_user_id_idx")
}

model connection {
  id              String   @id @default(uuid())
  name            String
  type            String   @default("EVOLUTION")
  status          String   @default("DISCONNECTED")
  instance_id     String?  @unique
  chatbot_enabled Boolean  @default(false)
  user_id         String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  user            user     @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "connection_user_id_idx")
}

model automation {
  id         String   @id @default(uuid())
  name       String
  description String?
  trigger    String
  actions    String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model knowledge_base {
  id         String   @id @default(uuid())
  title      String
  content    String
  category   String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model conversation {
  id           String   @id @default(uuid())
  phone_number String
  whatsapp_id  String   @unique
  messages     Json
  is_blocked   Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([whatsapp_id], map: "conversation_whatsapp_id_idx")
}

model ai_config {
  id             String   @id @default(uuid())
  behavior       String   @default("Professional and helpful assistant.")
  response_rules String   @default("Always be polite. Answer in the same language as the user.")
  user_id        String   @unique
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  user           user     @relation(fields: [user_id], references: [id])
}

model blocked_contact{
  id            String   @id @default(uuid())
  phone_number   String   @unique
  observation   String? 
  blockerTime   DateTime @default(now())
}

model user_instruction {
  id         String   @id @default(uuid())
  user_id    String
  content    String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id], map: "user_instruction_user_id_key")
  @@index([user_id], map: "user_instruction_user_id_idx")
}