generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(uuid())
  name           String
  slug           String         @unique
  email          String         @unique
  passwordHash   String         @map("password_hash")
  role           String         @default("user")
  failedAttempts Int            @default(0) @map("failed_attempts")
  lockedUntil    DateTime?      @map("locked_until")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  aiConfig       AIConfig?
  connections    Connection[]
  refreshTokens  RefreshToken[]

  @@map("user")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

model Connection {
  id             String   @id @default(uuid())
  name           String
  type           String   @default("EVOLUTION")
  status         String   @default("DISCONNECTED")
  instanceId     String?  @unique @map("instance_id")
  chatbotEnabled Boolean  @default(false) @map("chatbot_enabled")
  userId         String   @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("connection")
}

model Automation {
  id          String   @id @default(uuid())
  name        String
  description String?
  trigger     String
  actions     String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("automation")
}

model KnowledgeBase {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("knowledge_base")
}

model Contact {
  id        String   @id @default(uuid())
  name      String?
  number    String   @unique
  email     String?
  tags      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact")
}

model MessageLog {
  id        String   @id @default(uuid())
  from      String
  to        String
  content   String
  type      String   @default("text")
  status    String   @default("sent")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("message_log")
}

model AIConfig {
  id            String   @id @default(uuid())
  behavior      String   @default("Professional and helpful assistant.")
  responseRules String   @default("Always be polite. Answer in the same language as the user.") @map("response_rules")
  userId        String   @unique @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id])

  @@map("ai_config")
}