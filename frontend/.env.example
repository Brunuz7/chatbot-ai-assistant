# Variáveis no ficheiro /.env na raiz do monorepo (envDir do Vite).

# API
VITE_API_URL=http://localhost:3001

# Identidade da app (título, favicon, meta tags — injetadas no index.html no build)
VITE_APP_URL=http://localhost:5173
VITE_APP_TITLE=Assistente Prestei
VITE_APP_SHORT_TITLE=Prestei
VITE_APP_SITE_NAME=Assistente Prestei
VITE_APP_DESCRIPTION=Assistente inteligente para WhatsApp: fluxos, agentes de IA e automação.
VITE_APP_KEYWORDS=whatsapp,chatbot,automação,ia,prestei
VITE_APP_AUTHOR=Prestei
VITE_APP_THEME_COLOR=#175197
VITE_APP_FAVICON=/favicon.svg
# Pré-visualização em redes sociais — usar PNG/JPEG (SVG costuma não aparecer). Por defeito: public/og-image.png
# VITE_APP_OG_IMAGE=/og-image.png
VITE_APP_LOCALE=pt_BR
VITE_APP_TWITTER_CARD=summary_large_image
VITE_APP_ROBOTS=index, follow
