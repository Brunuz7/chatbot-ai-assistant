# Build do Vite: variáveis VITE_* são fixadas no momento do `npm run build`.
# Copie para frontend/.env.production.local ou exporte antes do build na VPS.

# URL base da API (sem / no fim). Pode incluir ou não o sufixo /api — o cliente normaliza.
# Mesmo domínio do site (Nginx faz proxy de /api para o Node):
#   VITE_API_URL=https://seudominio.com
# API em subdomínio:
#   VITE_API_URL=https://api.seudominio.com
VITE_API_URL=https://api.seudominio.com
